# Copie para .env.local e preencha com os dados do projeto Supabase.
# Project Settings -> API, no painel do Supabase.

NEXT_PUBLIC_SUPABASE_URL=https://yqnthodhudvzkhagozbb.supabase.co

# Chave service_role (SECRETA — somente servidor). O app acessa o banco pelo
# servidor (server actions), por isso usa a service_role e o RLS permanece travado
# para a API publica. NUNCA exponha esta chave no cliente nem faca commit dela.
SUPABASE_SERVICE_ROLE_KEY=coloque_a_service_role_key_aqui
